  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "DeleteAccount": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          },
          "confirm": {
            "type": "boolean",
            "const": true,
            "title": "Confirm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "confirm"
        ],
        "title": "DeleteAccount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PasswordChange": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange"
      },
      "PostInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Answer"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          },
          "source_platform": {
            "type": "string",
            "enum": [
              "DeepSeek",
              "ChatGPT",
              "豆包",
              "Kimi",
              "其他"
            ],
            "title": "Source Platform"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Source Url",
            "default": ""
          },
          "confirm_public": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Public"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "answer",
          "source_platform",
          "confirm_public"
        ],
        "title": "PostInput"
      },
      "Registration": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Display Name"
          },
          "invite_code": {
            "type": "string",
            "maxLength": 128,
            "minLength": 16,
            "title": "Invite Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password",
          "display_name",
          "invite_code"
        ],
        "title": "Registration"
      },
      "ReportInput": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "ReportInput"
      },
      "ReviewInput": {
